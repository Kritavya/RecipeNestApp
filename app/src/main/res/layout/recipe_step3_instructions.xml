<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F8F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8F8F8"
        android:paddingHorizontal="16dp"
        android:paddingBottom="80dp">

        <!-- Back button and title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackArrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back_arrow"
                android:background="@drawable/circle_light_background"
                android:padding="8dp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Instructions"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Step indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Step 1 (completed) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_active"
                android:text="1"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="14sp"/>

            <!-- Line connector -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#FF9A04"/>

            <!-- Step 2 (completed) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_active"
                android:text="2"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="14sp"/>

            <!-- Line connector -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#FF9A04"/>

            <!-- Step 3 (current) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_active"
                android:text="3"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="14sp"/>

            <!-- Line connector -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#DDDDDD"/>

            <!-- Step 4 (upcoming) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_inactive"
                android:text="4"
                android:textColor="#888888"
                android:gravity="center"
                android:textSize="14sp"/>

            <!-- Line connector -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#DDDDDD"/>

            <!-- Step 5 (upcoming) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_inactive"
                android:text="5"
                android:textColor="#888888"
                android:gravity="center"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Add instruction section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Instruction"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <!-- Instruction Title -->
        <EditText
            android:id="@+id/etInstructionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Instruction title (e.g., 'Prepare the sauce')"
            android:background="@drawable/rounded_edit_text"
            android:padding="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Instruction Step -->
        <EditText
            android:id="@+id/etInstructionStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Instruction step"
            android:background="@drawable/rounded_edit_text"
            android:padding="16dp"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="16dp"/>

        <!-- Add button -->
        <Button
            android:id="@+id/btnAddStep"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Add Step"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button"
            android:layout_marginBottom="24dp"/>

        <!-- Instructions list container -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instructions"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/instructionsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"/>

        <!-- Continue button -->
        <Button
            android:id="@+id/btnContinueStep3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button"
            android:layout_marginTop="16dp"/>

        <!-- Recipe Image Preview -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="24dp">

            <ImageView
                android:id="@+id/recipeImagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_image"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView> 