<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Recipe Image with Navigation Arrow -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <ImageView
                android:id="@+id/ivRecipeImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

            <ImageButton
                android:id="@+id/btnBackArrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|top"
                android:layout_margin="16dp"
                android:background="@drawable/circle_light_background"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btnNextImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="@drawable/circle_light_background"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="Next Image" />

            <!-- Image Pagination Indicators -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/dotIndicator1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_active"
                    android:backgroundTint="#FFA000"
                    android:layout_marginEnd="4dp" />

                <View
                    android:id="@+id/dotIndicator2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_inactive"
                    android:layout_marginEnd="4dp" />

                <View
                    android:id="@+id/dotIndicator3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_inactive" />
            </LinearLayout>
        </FrameLayout>

        <!-- Recipe Title and Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <TextView
                android:id="@+id/tvRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sausage Nasi Goreng"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/btn_star_big_on"
                    android:tint="@color/colorAccent" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.9"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Date and Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21 May 2024"
                    android:textColor="@color/colorLightText"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:tint="@color/colorLightText"
                    android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 Minutes"
                    android:textColor="@color/colorLightText"
                    android:textSize="14sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Categories -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/categoryContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asian"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:background="@drawable/rounded_light_background"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Indonesian"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:background="@drawable/rounded_light_background"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rice"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:background="@drawable/rounded_light_background"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oriental"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:background="@drawable/rounded_light_background"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Ingredients Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="16dp" />

        <!-- Ingredients Box with Gray Outline -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:contentPadding="0dp">
            
            <!-- Border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_light_border_background"/>
                
            <!-- Ingredients Container - Will be populated programmatically -->
            <LinearLayout
                android:id="@+id/ingredientsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Sample ingredient rows - will be replaced programmatically -->
                
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- How-to Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How-to"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="16dp" />
            
        <!-- How-to Box with Gray Outline -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:contentPadding="0dp">
            
            <!-- Border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_light_border_background"/>
                
            <!-- Instructions Container - Will be populated programmatically -->
            <LinearLayout
                android:id="@+id/instructionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Sample instruction rows - will be replaced programmatically -->
                
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnAddToMyRecipes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Add to My Recipes"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button"
            android:backgroundTint="#FFA000"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnDownloadRecipe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Download Recipe"
            android:textColor="#757575"
            android:background="@drawable/rounded_outlined_button"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp" />

        <!-- Rating Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:padding="16dp"
            android:background="@drawable/rounded_light_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What do you think about the recipe?"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textAlignment="center"
                android:layout_marginBottom="12dp" />

            <!-- Star Rating -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ratingStar1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/ratingStar2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/ratingStar3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/ratingStar4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/ratingStar5"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/btn_star_big_off" />
            </LinearLayout>

            <!-- Write Review Button -->
            <Button
                android:id="@+id/btnWriteReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Write a review"
                android:textColor="@color/colorLightText"
                android:background="@drawable/rounded_outlined_button"
                android:drawableStart="@android:drawable/ic_menu_edit"
                android:drawablePadding="8dp"
                android:paddingStart="16dp"
                android:gravity="center_vertical|start" />
        </LinearLayout>
    </LinearLayout>
</ScrollView> 