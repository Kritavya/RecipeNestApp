<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F8F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8F8F8"
        android:paddingHorizontal="16dp"
        android:paddingBottom="80dp">

        <!-- Back button and title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackArrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back_arrow"
                android:background="@drawable/circle_light_background"
                android:padding="8dp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Additional Information"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Step indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Step 1 (completed) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_active"
                android:text="1"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="14sp"/>

            <!-- Line connector -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#FF9A04"/>

            <!-- Step 2 (completed) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_active"
                android:text="2"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="14sp"/>

            <!-- Line connector -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#FF9A04"/>

            <!-- Step 3 (completed) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_active"
                android:text="3"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="14sp"/>

            <!-- Line connector -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#FF9A04"/>

            <!-- Step 4 (current) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_active"
                android:text="4"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textSize="14sp"/>

            <!-- Line connector -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#DDDDDD"/>

            <!-- Step 5 (upcoming) -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot_inactive"
                android:text="5"
                android:textColor="#888888"
                android:gravity="center"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Recipe Image Preview -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/recipeImagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ramen_sample"/>
        </androidx.cardview.widget.CardView>

        <!-- Cooking Times Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cooking Times"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="8dp" />

        <!-- Prep Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prep Time (min):"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/etPrepTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_edit_text"
                android:padding="12dp"
                android:inputType="number"
                android:hint="30"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Cook Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cook Time (min):"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/etCookTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_edit_text"
                android:padding="12dp"
                android:inputType="number"
                android:hint="45"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Servings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servings:"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/etServings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_edit_text"
                android:padding="12dp"
                android:inputType="number"
                android:hint="4"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Video URL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video URL:"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/etVideoUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_edit_text"
                android:padding="12dp"
                android:inputType="textUri"
                android:hint="https://youtube.com/watch?v=..."
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Recipe Details Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe Details"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Difficulty Level -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Difficulty:"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_gravity="center_vertical" />

            <Spinner
                android:id="@+id/spinnerDifficulty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_edit_text"
                android:padding="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Cuisine Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuisine Type:"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_gravity="center_vertical" />

            <Spinner
                android:id="@+id/spinnerCuisineType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_edit_text"
                android:padding="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Continue Button -->
        <Button
            android:id="@+id/btnContinueStep4"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/rounded_button"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView> 