<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.Figma" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Ensure Material 3 button tinting is fully disabled -->
        <item name="buttonStyle">@style/CustomButtonStyle</item>
        <item name="materialButtonStyle">@style/CustomButtonStyle</item>
        <!-- Set status bar color -->
        <item name="android:statusBarColor">#F8F8F8</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.RecipeNest" parent="Base.Theme.Figma" />


    <!-- Custom Button Style to Remove Tinting -->
    <style name="CustomButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>
</resources>
