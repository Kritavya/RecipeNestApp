<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecipeNest"
        tools:targetApi="31">

        <!-- Splash Screen (First Screen When App Opens) -->
        <activity
            android:name=".SplashScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Screens -->
        <activity android:name=".OnboardingActivity" android:exported="false"/>
        <activity android:name=".OnboardingActivity2" android:exported="false"/>
        <activity android:name=".OnboardingActivity3" android:exported="false"/>
        <activity android:name=".OnboardingActivity4" android:exported="false"/>



        <!-- Login Screen -->
        <activity android:name=".LoginActivity" android:exported="false"/>

        <!-- Signup Screen -->
        <activity android:name=".SignupActivity" android:exported="false"/>

        <!-- Personlization Screens -->
        <activity android:name=".PersonalizationActivity" android:exported="false"/>


        <!-- Forgot Password Screen-->
        <activity android:name=".ForgotPasswordActivity" android:exported="false"/>


        <!-- Main Activity (Final Destination After Onboarding/Login) -->
        <activity android:name=".MainActivity" android:exported="true" />

        <!-- Firebase Integration (if needed in the future)
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id"/> -->

    </application>

</manifest>
